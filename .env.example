# AI Dev Orchestrator — environment example
# Copy to .env and fill in what you need. Keys can ALSO be entered in the UI
# (stored encrypted at rest in the local database). Environment variables are
# only used as a fallback/seed when the database has no credential for a provider.

# --- Server ---
AIDO_HOST=0.0.0.0
AIDO_API_PORT=8787
AIDO_WEB_PORT=5173
AIDO_LOG_LEVEL=info            # trace|debug|info|warn|error

# --- Storage ---
# SQLite (default, zero-ops). For Postgres see docs/DEVELOPMENT.md.
AIDO_DB_PATH=.data/aido.db
# Master key material for encrypting provider credentials at rest.
# If unset, a random 32-byte key is generated at .data/master.key (chmod 600).
# AIDO_MASTER_KEY=<base64 or passphrase>

# --- Workspaces ---
# Root directory where agent workspaces (cloned/generated projects) live.
AIDO_WORKSPACE_ROOT=.workspaces
# Comma separated absolute paths agents may never touch.
AIDO_FS_DENY_PATHS=

# --- Execution mode ---
AIDO_EXECUTION_MODE=supervised  # auto|supervised|manual

# --- Provider credentials (optional; UI entry preferred) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NVIDIA_API_KEY=
HUGGINGFACE_API_KEY=
COHERE_API_KEY=
