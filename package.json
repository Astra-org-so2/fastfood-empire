{
  "name": "ai-dev-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Dev Orchestrator — a multi-provider, quota-aware, multi-agent AI software engineering platform.",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:worker": "tsx apps/worker/src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/api/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:ui": "vitest run test/ui",
    "db:migrate": "tsx scripts/migrate.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "build:desktop": "node scripts/build-desktop.mjs",
    "package:desktop": "node apps/desktop/packaging/package-tool.mjs --target=deb",
    "package:desktop:all": "node apps/desktop/packaging/package-tool.mjs --target=deb --target=AppImage",
    "start:desktop": "node apps/desktop/packaging/start.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
